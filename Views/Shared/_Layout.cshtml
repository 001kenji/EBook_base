<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EBook</title>
    <script type="importmap"></script>
    <!-- Bootstrap 5 + Icons + Google Fonts -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-GLhlTQ8iRABdZLl6O3oVMWSktQOp6b7In1Zl3/Jr59b6EGGoI1aFkw7cmDA6j6gD" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.3/font/bootstrap-icons.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600&display=swap" rel="stylesheet">
    <!-- Your original styles -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EBook.styles.css" asp-append-version="true" />
    <!-- Additional modern style -->
    <style>
            /* modern overrides & enhancements */
            :root {
                --primary-gradient: linear-gradient(145deg, #1e2b3c 0%, #0f1a26 100%);
                --accent: #4f9cf9;
                --accent-soft: #e8f0fe;
                --surface: #ffffff;
                --bg-light: #f8fafd;
                --shadow-sm: 0 8px 20px rgba(0, 0, 0, 0.02), 0 4px 12px rgba(0, 0, 0, 0.03);
                --shadow-md: 0 18px 40px -12px rgba(0, 20, 40, 0.2);
                --radius-lg: 24px;
                --radius-md: 16px;
                --radius-sm: 12px;
            }

            * {
                transition: background-color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease, transform 0.15s ease;
            }

            body {
                font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
                background-color: var(--bg-light);
                color: #1f2a3a;
                display: flex;
                flex-direction: column;
                min-height: 100vh;
                margin: 0;
            }

            /* modern navbar */
            .navbar {
                background: rgba(255, 255, 255, 0.8) !important;
                backdrop-filter: blur(12px);
                -webkit-backdrop-filter: blur(12px);
                border-bottom: 1px solid rgba(0, 0, 0, 0.02) !important;
                box-shadow: var(--shadow-sm) !important;
                padding: 0.9rem 0;
                transition: all 0.2s;
            }

            .navbar-brand {
                font-weight: 600;
                font-size: 1.5rem;
                letter-spacing: -0.02em;
                background: linear-gradient(135deg, #0b1e2e, #1e3b5a);
                -webkit-background-clip: text;
                background-clip: text;
                -webkit-text-fill-color: transparent;
                margin-right: 1.5rem;
            }

            .navbar-brand i {
                background: none;
                -webkit-text-fill-color: initial;
                color: var(--accent);
                margin-right: 6px;
            }

            .navbar-nav .nav-link {
                font-weight: 500;
                padding: 0.6rem 1rem !important;
                border-radius: 40px;
                color: #1f2a3a !important;
                opacity: 0.85;
                margin: 0 2px;
            }

            .navbar-nav .nav-link:hover,
            .navbar-nav .nav-link:focus {
                background-color: var(--accent-soft);
                opacity: 1;
                color: #0b2d4e !important;
            }

            .navbar-nav .nav-link.active {
                background-color: var(--accent-soft);
                color: #0b2d4e !important;
                font-weight: 600;
            }

            .navbar-toggler {
                border: none;
                padding: 0.5rem 0.8rem;
                border-radius: 40px;
                background: #f0f4fa;
            }

            .navbar-toggler:focus {
                box-shadow: 0 0 0 3px rgba(79, 156, 249, 0.3);
            }

            /* main container as card */
            .container {
                max-width: 1320px;
            }

            main[role="main"] {
                background: var(--surface);
                border-radius: var(--radius-lg);
                box-shadow: var(--shadow-md);
                padding: 2.2rem 2rem;
                margin-top: 1.5rem;
                margin-bottom: 2rem;
                border: 1px solid rgba(255, 255, 255, 0.5);
                backdrop-filter: blur(4px);
            }

            /* footer */
            .footer {
                background: transparent !important;
                border-top: 1px solid rgba(0, 0, 0, 0.04) !important;
                color: #6b7a8d !important;
                padding: 1.5rem 0;
                font-size: 0.9rem;
                margin-top: auto;
            }

            .footer a {
                color: #2c3e50;
                text-decoration: none;
                font-weight: 500;
                border-bottom: 1px dashed #a0b8d0;
            }

            .footer a:hover {
                color: var(--accent);
                border-bottom-color: var(--accent);
            }

            /* login partial styling (assuming standard .nav-link etc) */
            .navbar .navbar-collapse .navbar-nav:last-child {
                align-items: center;
            }

            /* buttons & accents */
            .btn-primary {
                background-color: var(--accent);
                border-color: var(--accent);
                border-radius: 40px;
                padding: 0.5rem 1.25rem;
                font-weight: 500;
            }

            .btn-primary:hover {
                background-color: #2b7fd9;
                border-color: #2b7fd9;
                transform: translateY(-1px);
                box-shadow: 0 8px 18px -6px rgba(79, 156, 249, 0.4);
            }

            h1, h2, h3, h4, h5 {
                font-weight: 600;
                letter-spacing: -0.02em;
            }

            /* responsive spacing */
            @@media (max-width: 768px) {
                main[role="main"] {
                    padding: 1.5rem 1rem;
                    border-radius: var(--radius-md);
                }
                .navbar-brand {
                    font-size: 1.3rem;
                }
                .navbar-collapse {
                    padding: 1rem 0;
                }
                .navbar-nav .nav-link {
                    padding: 0.6rem 1rem !important;
                }
            }

            /* subtle animations for links */
            a {
                text-decoration: none;
            }

            /* make home page content breathe */
            .display-4 {
                font-weight: 600;
                background: linear-gradient(135deg, #0b1e2e, #1e3b5a);
                -webkit-background-clip: text;
                background-clip: text;
                -webkit-text-fill-color: transparent;
            }

            /* optional: small pill for viewdata */
            .navbar .container-fluid {
                padding-left: 1rem;
                padding-right: 1rem;
            }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-book-half"></i> EBook
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Libraries" asp-action="Index">
                                <i class="bi bi-collection me-1"></i> Library
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Payments" asp-action="Index">
                                <i class="bi bi-credit-card me-1"></i> Payments
                            </a>
                        </li>
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

   
    <!-- Bootstrap 5 bundle & original scripts (keep both for compatibility) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js" integrity="sha384-w76AqPfDkMBDXo30jS1Sgez6pr3x5MlQ1ZAGC+nuZB+EYdgRZgiwxhTBTkF7CXvN" crossorigin="anonymous"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>



</html>