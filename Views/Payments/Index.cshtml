@model IEnumerable<EBook.Models.Payment>

@{
    ViewData["Title"] = "Payments";
    var isAdmin = User.IsInRole("Admin");
}

<div class="page-header">
    <div>
        <h1>Payments</h1>
        <span class="subtitle">Track and manage all payment records</span>
    </div>
    <div>
        @if (isAdmin)
        {
            <a asp-action="Create" class="btn-pill btn-pill-primary">
                <i class="bi bi-plus-lg"></i> Create New
            </a>
        }
    </div>
</div>

@if (Model == null || !Model.Any())
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-credit-card-2-front" style="font-size:2.5rem;"></i>
        <p class="mt-3 mb-0">No payments recorded yet.</p>
    </div>
}
else
{
    <table class="table-modern">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.Amount)</th>
                <th>@Html.DisplayNameFor(model => model.PaymentMethod)</th>
                <th>@Html.DisplayNameFor(model => model.PaymentDate)</th>
                <th>@Html.DisplayNameFor(model => model.PaymentStatus)</th>
                @if (isAdmin)
                {
                    <th>@Html.DisplayNameFor(model => model.UserId)</th>
                }
                <th style="width:1%; white-space:nowrap;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><strong>@Html.DisplayFor(model => item.Amount)</strong></td>
                    <td>
                        <span class="chip">
                            <i class="bi bi-wallet2"></i>
                            @Html.DisplayFor(model => item.PaymentMethod)
                        </span>
                    </td>
                    <td class="text-muted small">@Html.DisplayFor(model => item.PaymentDate)</td>
                    <td>
                        @{
                            var status = item.PaymentStatus?.ToString() ?? "";
                            var statusClass = status.ToLower() switch
                            {
                                "paid" or "completed" or "success" => "status-paid",
                                "pending" or "processing" => "status-pending",
                                "failed" or "cancelled" => "status-failed",
                                _ => "status-neutral"
                            };
                        }
                        <span class="status-badge @statusClass">
                            <i class="bi bi-circle-fill"></i>
                            @status
                        </span>
                    </td>
                    @if (isAdmin)
                    {
                        <td class="text-muted small">@Html.DisplayFor(model => item.UserId)</td>
                    }
                    <td>
                        <div class="table-actions">
                            <a asp-action="Details" asp-route-id="@item.id" class="btn-pill btn-pill-neutral">
                                <i class="bi bi-eye"></i> Details
                            </a>
                            @if (isAdmin)
                            {
                                <a asp-action="Edit" asp-route-id="@item.id" class="btn-pill btn-pill-primary">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.id" class="btn-pill btn-pill-danger">
                                    <i class="bi bi-trash"></i> Delete
                                </a>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}