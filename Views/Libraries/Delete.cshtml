@model EBook.Models.Library

@{
    ViewData["Title"] = "Delete";
}

<div class="page-header">
    <div>
        <h1>Delete Library Entry</h1>
        <span class="subtitle">This action cannot be undone</span>
    </div>
    <a asp-action="Index" class="btn-pill btn-pill-neutral">
        <i class="bi bi-arrow-left"></i> Back to List
    </a>
</div>

<div class="details-card">
    <div class="delete-warning">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <div>
            <strong>Are you sure you want to delete this entry?</strong>
            <div class="small">The record will be permanently removed from the library.</div>
        </div>
    </div>

    <dl class="details-list">
        <dt>@Html.DisplayNameFor(model => model.Name)</dt>
        <dd>@Html.DisplayFor(model => model.Name)</dd>

        <dt>@Html.DisplayNameFor(model => model.Scope)</dt>
        <dd>@Html.DisplayFor(model => model.Scope)</dd>

        <dt>@Html.DisplayNameFor(model => model.Curriculum)</dt>
        <dd>@Html.DisplayFor(model => model.Curriculum)</dd>

        <dt>@Html.DisplayNameFor(model => model.FilePath)</dt>
        <dd class="text-muted small">@Html.DisplayFor(model => model.FilePath)</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="id" />
        <div class="form-actions">
            <button type="submit" class="btn-pill btn-pill-danger">
                <i class="bi bi-trash"></i> Yes, delete
            </button>
            <a asp-action="Index" class="btn-pill btn-pill-neutral">Cancel</a>
        </div>
    </form>
</div>