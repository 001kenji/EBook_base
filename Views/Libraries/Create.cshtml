@model EBook.Models.Library

@{
    ViewData["Title"] = "Create";
}

<div class="page-header">
    <div>
        <h1>Create Library</h1>
        <span class="subtitle">Add a new book or file to the collection</span>
    </div>
    <a asp-action="Index" class="btn-pill btn-pill-neutral">
        <i class="bi bi-arrow-left"></i> Back to List
    </a>
</div>

<div class="form-card">
    <form asp-action="Create" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="form-group">
            <label asp-for="Name" class="control-label">
                <i class="bi bi-book me-1"></i> @Html.DisplayNameFor(m => m.Name)
            </label>
            <input asp-for="Name" class="form-control" placeholder="e.g. Introduction to Physics" />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>

        <div class="form-group">
            <label asp-for="Scope" class="control-label">
                <i class="bi bi-bullseye me-1"></i> @Html.DisplayNameFor(m => m.Scope)
            </label>
            <input asp-for="Scope" class="form-control" placeholder="e.g. Secondary School" />
            <span asp-validation-for="Scope" class="text-danger small"></span>
        </div>

        <div class="form-group">
            <label asp-for="Curriculum" class="control-label">
                <i class="bi bi-mortarboard me-1"></i> @Html.DisplayNameFor(m => m.Curriculum)
            </label>
            <input asp-for="Curriculum" class="form-control" placeholder="e.g. CBC" />
            <span asp-validation-for="Curriculum" class="text-danger small"></span>
        </div>

        <div class="form-group">
            <label class="control-label">
                <i class="bi bi-upload me-1"></i> Upload book / file
            </label>
            <input type="file" name="uploadFile" class="form-control" required />
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-pill btn-pill-primary">
                <i class="bi bi-check-lg"></i> Create
            </button>
            <a asp-action="Index" class="btn-pill btn-pill-neutral">Cancel</a>
        </div>
    </form>
</div>